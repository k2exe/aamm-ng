#!/bin/sh /etc/rc.common

START=96
STOP=9

USE_PROCD=1

PROG=/usr/sbin/aamm-ng-web

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"

	procd_set_param user aamm-ng-web
	procd_set_param group aamm-ng-control

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
